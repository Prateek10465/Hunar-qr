# Copy to .env and edit. Everything is optional: with no changes the server runs in demo mode.

# --- Basics
PUBLIC_BASE_URL=http://localhost:8000     # used inside QR codes and links; set to your real https URL
DATA_DIR=data                             # SQLite DB, issuer key and photos live here (mount a volume)
PASSPORT_ID_PREFIX=HQR-TN
ISSUER_DID=did:example:hunar-qr-demo-issuer
# ISSUER_KEY_PEM=                         # optional: PEM private key; otherwise generated in DATA_DIR
# HASH_SECRET=                            # optional: HMAC key for phone hashes; otherwise generated in DATA_DIR

# --- HTTP
ENABLE_DEMO_API=true                      # set false in production (turns off /api/passports, /api/chat, /api/demo-passport)
CORS_ORIGINS=*
TRUST_PROXY=false                         # true only behind a proxy you control (reads X-Forwarded-For)
MAX_UPLOAD_BYTES=5000000
RATE_ANALYZE_PER_MIN=60
RATE_MINT_PER_MIN=10
RATE_CHAT_PER_MIN=90

# --- Providers (defaults are mocks: credentials issued with mocks are marked assurance "demo")
ASR_PROVIDER=mock                         # mock | http
# ASR_URL=https://your-asr.example/transcribe
# ASR_TOKEN=
VISION_PROVIDER=mock                      # mock | claude
# ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
TTS_PROVIDER=none                         # none | http
# TTS_URL=
# TTS_TOKEN=

# --- WhatsApp Cloud API (see docs/WHATSAPP_SETUP.md)
# WHATSAPP_VERIFY_TOKEN=choose-any-string
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# GRAPH_API_VERSION=v21.0
# ALLOW_UNSIGNED_WEBHOOK=false            # never true in production
